ontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.31;entryDx=0;entryDy=0;" edge="1" parent="1" source="fg" target="flows"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.4;strokeColor=#444444;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="rg" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.4;strokeColor=#444444;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="msgs" target="flows"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="이어가기 ≤1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.4;strokeColor=#444444;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="flows"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.4;strokeColor=#444444;startArrow=none;endArrow=open;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;fontColor=#888888;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flows" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ob" value="개시 기록&lt;br&gt;(FK 아님)" style="text;html=1;align=right;fontSize=11;fontColor=#888888;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="105" height="34" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;읽는 법&lt;/b&gt;&lt;br&gt;선 끝: &lt;b&gt;||&lt;/b&gt; 반드시 하나 · &lt;b&gt;|○&lt;/b&gt; 없거나 하나 · 까마귀발 여럿&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; 기본 키 · &lt;b&gt;FK&lt;/b&gt; 외래 키 · &lt;b&gt;UQ&lt;/b&gt; 유일 · ? NULL 허용&lt;br&gt;&lt;br&gt;목표는 흐름에도 예약에도 직접 묶이지 않고, 가운데 연결 테이블로 이어진다.&lt;br&gt;흐름 밖 메시지는 &lt;code&gt;flow_id IS NULL&lt;/code&gt;. 흐름을 여는 커밋이 전부 흡수한다(I8)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;spacing=8;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1140" y="725" width="360" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>