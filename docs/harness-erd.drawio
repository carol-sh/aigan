0px;font-weight:bold;white-space:nowrap'&gt;&lt;/td&gt;&lt;td style='font-family:monospace;font-size:12px;color:#222;white-space:nowrap'&gt;updated_by_flow_id&lt;/td&gt;&lt;td style='font-size:11px;color:#666;text-align:right;padding-left:6px;padding-right:8px;white-space:nowrap'&gt;기록용&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacing=0;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="340" height="107.5" as="geometry"/></mxCell><mxCell id="msec" value="&lt;div style='background:#ffe6cc;border-bottom:1px solid #d79b00;padding:6px 0;font-weight:bold;font-size:14px;color:#222'&gt;memory_sections&lt;div style='font-weight:normal;font-size:11px;color:#555;margin-top:2px'&gt;장기 기억의 칸. 호출엔 제목만, 본문은 memory_read&lt;/div&gt;&lt;/div&gt;&lt;table style='width:100%;border-collapse:collapse;margin-top:3px;padding:0 6px' cellpadding='1'&gt;&lt;tr&gt;&lt;td style='width:44px;padding-left:6px;color:#b36b00;font-size:10px;font-weight:bold;white-space:nowrap'&gt;PK&lt;/td&gt;&lt;td style='font-family:monospace;font-size:12px;color:#222;white-space:nowrap'&gt;title&lt;/td&gt;&lt;td style='font-size:11px;color:#666;text-align:right;padding-left:6px;padding-right:8px;white-space:nowrap'&gt;1–100자&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:44px;padding-left:6px;color:#b36b00;font-size:10px;font-weight:bold;white-space:nowrap'&gt;&lt;/td&gt;&lt;td style='font-family:monospace;font-size:12px;color:#222;white-space:nowrap'&gt;content&lt;/td&gt;&lt;td style='font-size:11px;color:#666;text-align:right;padding-left:6px;padding-right:8px;white-space:nowrap'&gt;≤ section_max_chars&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:44px;padding-left:6px;color:#b36b00;font-size:10px;font-weight:bold;white-space:nowrap'&gt;&lt;/td&gt;&lt;td style='font-family:monospace;font-size:12px;color:#222;white-space:nowrap'&gt;created_at / updated_at&lt;/td&g