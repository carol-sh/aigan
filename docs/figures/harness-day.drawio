Space=wrap;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="588.0" y="438.0" width="100.0" height="14.0" as="geometry"/></mxCell><mxCell id="c117" value="G1 알고리즘 1문제 · 마감 12:00" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fontSize=11;fontColor=#222222;align=left;spacingLeft=4;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="584.0" y="478.0" width="276.0" height="22.0" as="geometry"/></mxCell><mxCell id="c118" value="&lt;b&gt;done&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="864.0" y="481.0" width="70.0" height="18.0" as="geometry"/></mxCell><mxCell id="c119" value="" style="html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.2;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584.0" y="434.0" as="sourcePoint"/><mxPoint x="584.0" y="478.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c120" value='G2 운동 30분 · 마감 19:00 · 19:30 "아직" → 진행 메모 갱신' style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fontSize=11;fontColor=#222222;align=left;spacingLeft=4;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920.0" y="520.0" width="672.0" height="22.0" as="geometry"/></mxCell><mxCell id="c121" value="&lt;b&gt;expired&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="1596.0" y="523.0" width="70.0" height="18.0" as="geometry"/></mxCell><mxCell id="c122" value="" style="html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.2;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920.0" y="434.0" as="sourcePoint"/><mxPoint x="920.0" y="520.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c123" value="흐름 밖에서는 R4가 G1을 붙잡음(I3)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="644.0" y="503.0" width="200.0" height="16.0" as="geometry"/></mxCell><mxCell id="c124" value="&lt;b&gt;개시 예약&lt;/b&gt;&lt;br&gt;계획·턴·하네스 보정이 만든다. 발화하면 흐름을 연다. 흐름이 열려 있으면 fired로 대기했다가 닫힌 뒤 처리. 지난 계획일 것은 날 넘김이 지운다." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacing=8;fillColor=#fff3e0;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20.0" y="580.0" width="448.0" height="84.0" as="geometry"/></mxCell><mxCell id="c125" value="&lt;b&gt;흐름&lt;/b&gt;&lt;br&gt;한 번에 하나. AI가 end하거나 블랙아웃 시작에 닫힌다. 닫히면 정리(기억 쓰기)가 다음 흐름보다 먼저 돈다. 흐름 밖 메시지는 판정(무시 포함) 뒤 다음 흐름이 흡수한다." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacing=8;fillColor=#eef7ea;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="478.0" y="580.0" width="448.0" height="84.0" as="geometry"/></mxCell><mxCell id="c126" value="&lt;b&gt;목표&lt;/b&gt;&lt;br&gt;흐름의 턴만 만들고 닫는다. 흐름 밖에서는 자기를 가리키는 개시 예약이 붙잡는다(I3). 그날 닫히지 않으면 날 넘김이 expired로 닫고, 다음 날 계획이 본다." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacing=8;fillColor=#eaf1fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="936.0" y="580.0" width="448.0" height="84.0" as="geometry"/></mxCell><mxCell id="c127" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;○ 턴(LLM 호출) &amp;nbsp; &lt;font color='#f0a030'&gt;●&lt;/font&gt; continue 예약이 깨운 턴&lt;br&gt;▼ 예약 발화 &amp;nbsp; 점선 = fired 대기 &amp;nbsp; &lt;font color='#c0392b'&gt;✕&lt;/font&gt; 삭제&lt;br&gt;● 사용자 메시지 &amp;nbsp; 정리·판정·계획도 LLM 호출" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1394.0" y="580.0" width="448.0" height="84.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>