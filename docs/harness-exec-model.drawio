<mxfile host="app.diagrams.net"><diagram id="exec" name="실행 모델"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tg" value="&lt;b&gt;텔레그램&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;사용자&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="140" height="70" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM API&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1110" y="292" width="100" height="56" as="geometry"/></mxCell><mxCell id="pl" value="&lt;b&gt;생산자&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;기록하고 깨우기만&lt;/font&gt;" style="rounded=1;arcSize=4;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=6;fontSize=14;fontColor=#222222;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="230" y="80" width="200" height="520" as="geometry"/></mxCell><mxCell id="po" value="&lt;b&gt;텔레그램 폴러&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="pl"><mxGeometry x="20" y="60" width="160" height="50" as="geometry"/></mxCell><mxCell id="ti" value="&lt;b&gt;타이머&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;가장 이른 예약 1개 대기&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="pl"><mxGeometry x="20" y="140" width="160" height="60" as="geometry"/></mxCell><mxCell id="ck" value="&lt;b&gt;시계&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;블랙아웃·계획일 경계&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="pl"><mxGeometry x="20" y="230" width="160" height="60" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;reset 등&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="pl"><mxGeometry x="20" y="320" width="160" height="60" as="geometry"/></mxCell><mxCell id="dl" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;유일한 진실&lt;/font&gt;" style="rounded=1;arcSize=4;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=6;fontSize=14;fontColor=#222222;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="500" y="80" width="240" height="520" as="geometry"/></mxCell><mxCell id="ms" value="&lt;b&gt;messages&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;사용자 메시지 + 판정 상태&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="dl"><mxGeometry x="20" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;reservations&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;continue · open · fired&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="dl"><mxGeometry x="20" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;flows · goals · plans&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;흐름 열림 = 게이트&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="dl"><mxGeometry x="20" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="ob" value="&lt;b&gt;outbox&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;보낼 메시지 줄 · sent_at&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="dl"><mxGeometry x="20" y="350" width="200" height="60" as="geometry"/></mxCell><mxCell id="ll" value="&lt;b&gt;루프&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;단일 스레드, 한 번에 하나&lt;/font&gt;" style="rounded=1;arcSize=4;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=6;fontSize=14;fontColor=#222222;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="810" y="80" width="220" height="520" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1 다음 작업 고르기&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;흐름이 열려 있으면 그 흐름 것만&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="ll"><mxGeometry x="15" y="60" width="180" height="56" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 읽기&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;상태 확인, 스냅샷&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="ll"><mxGeometry x="15" y="136" width="180" height="56" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 LLM 호출&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#2d7a2d'&gt;이 동안 새 일은 기록만 됨&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#e8f5e3;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="ll"><mxGeometry x="15" y="212" width="180" height="56" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 커밋&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;상태 갱신 + outbox 적재&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="ll"><mxGeometry x="15" y="288" width="180" height="56" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5 전송&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;outbox 순서대로, sent_at 기록&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="ll"><mxGeometry x="15" y="364" width="180" height="56" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6 후속 처리&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;I3 보정, 닫혔으면 정리(memory)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontColor=#222222;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="ll"><mxGeometry x="15" y="440" width="180" height="56" as="geometry"/></mxCell><mxCell id="c2" value="① 메시지" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#333333;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tg" target="po"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="165"/></Array></mxGeometry></mxCell><mxCell id="c3" value="② 기록" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#333333;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl" target="dl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="③ 깨우기 (상태는 안 바꿈)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#d79b00;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;fontColor=#b36b00;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl" target="ll"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="40"/><mxPoint x="920" y="40"/></Array></mxGeometry></mxCell><mxCell id="c5" value="④ 읽기" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#333333;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3153846153846154;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dl" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="⑤ 호출·응답" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#333333;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="⑥ 커밋" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#333333;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6076923076923076;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="dl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="⑦ 전송" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#333333;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="tg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="472"/><mxPoint x="785" y="650"/><mxPoint x="100" y="650"/></Array></mxGeometry></mxCell><mxCell id="c9" value="다음 시각 조회" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rs" target="ti"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#888888;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1018" y="548"/><mxPoint x="1018" y="168"/></Array></mxGeometry></mxCell><mxCell id="lg1" value="&lt;b&gt;읽는 순서&lt;/b&gt;&lt;br&gt;① 사용자가 보낸 메시지를 폴러가 받는다.&lt;br&gt;② 생산자는 일어난 일(메시지, 예약 발화, 경계, CLI 명령)을 DB에 적는다.&lt;br&gt;③ 그리고 루프를 깨운다. 생산자는 상태를 바꾸지 않는다.&lt;br&gt;④ 루프가 DB에서 다음 할 일을 읽는다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;spacing=8;rounded=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="560" height="100" as="geometry"/></mxCell><mxCell id="lg2" value="⑤ LLM을 호출한다. 그동안 들어온 일은 DB에 적히기만 한다.&lt;br&gt;⑥ 결과를 한 번에 커밋한다. 보낼 말은 outbox에 쌓인다.&lt;br&gt;⑦ 커밋 직후 루프가 직접 보낸다(v3와 같음).&lt;br&gt;흐름이 닫히면 6에서 정리(memory)를 마친 뒤에야 다음 흐름을 고른다.&lt;br&gt;&lt;font color='#666'&gt;굵은 실선: 데이터 이동 · 주황 점선: 신호만 · 회색: 루프 내부 순서와 조회&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;spacing=8;rounded=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="590" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>